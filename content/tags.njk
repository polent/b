---
pagination:
  data: collections.tagPages
  size: 1
  alias: tag
  addAllPagesToCollections: true
layout: layouts/home.njk
eleventyComputed:
  title: Tagged with “{{ tag.name }}”
permalink: /tags/{{ tag.slug }}/
---
<h1>Tagged with “{{ tag.name }}”</h1>

{%- if tag.variants | length %}
<p class="tag-variants">Also written as {% for s in tag.variants %}<code>{{ s }}</code>{% if not loop.last %}, {% endif %}{% endfor %} — all the same topic.</p>
{%- endif %}

{% set postslist = tag.posts | reverse %}
{% set headingLevel = 2 %}
{% set showYears = false %}
{% include "postslist.njk" %}

<p>See <a href="/tags/">all tags</a>.</p>
